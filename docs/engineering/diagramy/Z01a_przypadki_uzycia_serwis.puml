@startuml Z01a_przypadki_uzycia_serwis
' Załącznik — przypadki użycia serwisu WWW (docs/)
' Zgodnie z: docs/*.html, docs/assets/app.js, docs/portfolio/index.html (localStorage),
' docs/engineering/WYMAGANIA.md (FR-34 – FR-53).
!include _styl.iuml
left to right direction
skinparam ranksep 40

actor "Użytkownik\nserwisu" as U

rectangle "Serwis WWW (docs/, GitHub Pages)" {
  usecase "UC-15 Przegląd rynku\n(KPI, mapa ciepła, liderzy)" as UC15
  usecase "UC-01 Przeglądanie\npanelu sygnałów" as UC01
  usecase "UC-04 Wykresy cen\n(świece, RSI, MACD)" as UC04
  usecase "UC-05 Wykresy\nanalizy ML" as UC05
  usecase "UC-16 Porównanie portfeli\nmonitorujących" as UC16
  usecase "UC-06 Symulacja\nwłasnego portfela" as UC06
  usecase "UC-10 Zmiana\njęzyka PL/EN" as UC10
  usecase "UC-11 Zmiana\nmotywu" as UC11
  usecase "UC-12 Lektura instrukcji\ni informacji o stronie" as UC12
  usecase "UC-14 Podgląd daty\naktualizacji danych" as UC14

  usecase "UC-02 Filtrowanie\nsygnałów" as UC02
  usecase "UC-03 Pobranie\neksportu CSV" as UC03
  usecase "UC-07 Zapis portfela\nw localStorage" as UC07
  usecase "UC-08 Eksport i import\nportfela (JSON)" as UC08
  usecase "UC-09 Przełączenie\nwaluty USD/PLN" as UC09
}

U -- UC15
U -- UC01
U -- UC04
U -- UC05
U -- UC16
U -- UC06
U -- UC10
U -- UC11
U -- UC12
U -- UC14

UC01 <.. UC02 : <<extend>>
UC01 <.. UC03 : <<extend>>
UC06 ..> UC07 : <<include>>
UC06 <.. UC08 : <<extend>>
UC06 <.. UC09 : <<extend>>

note "UC-01, 04, 05, 06, 14, 15 i 16 wczytują dane\nz docs/data (HTTP GET); bez logowania i kont." as N1
@enduml
